new file mode 100644
index 0000000..9baff71
--- /dev/null
+++ b/k8s/ingress.yaml
@@ -0,0 +1,29 @@
+# Ingress + TLS (partie P4, séance K2) — expose Flask en HTTPS via Traefik (k3s).
+# Pré-requis : créer le secret TLS (cert auto-signé) —
+#   openssl req -x509 -nodes -newkey rsa:2048 -days 365 -subj "/CN=shellter.local" \
+#     -keyout tls.key -out tls.crt
+#   kubectl -n shellter create secret tls shellter-tls --cert=tls.crt --key=tls.key
+# Puis ajouter "192.168.56.10  shellter.local" dans /etc/hosts.
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: shellter
+  namespace: shellter
+  annotations:
+    traefik.ingress.kubernetes.io/router.entrypoints: websecure
+spec:
+  tls:
+    - hosts:
+        - shellter.local
+      secretName: shellter-tls
+  rules:
+    - host: shellter.local
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: flask
+                port:
+                  number: 80
diff --git a/k8s/reconciler-cronjob.yaml b/k8s/reconciler-cronjob.yaml
new file mode 100644
index 0000000..e745afb
--- /dev/null
+++ b/k8s/reconciler-cronjob.yaml
@@ -0,0 +1,36 @@
+# Réconciliation (partie P4, séance K4) — aligne la base sur l'état du cluster.
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: shellter-reconciler
+  namespace: shellter
+spec:
+  schedule: "*/1 * * * *"
+  concurrencyPolicy: Forbid
+  jobTemplate:
+    spec:
+      activeDeadlineSeconds: 120
+      template:
+        spec:
+          serviceAccountName: shellter-api
+          restartPolicy: Never
+          containers:
+            - name: reconciler
+              image: ghcr.io/jamaiali/shellter-flask:latest
+              command: ["python", "scripts/k8s_reconciler.py"]
+              envFrom:
+                - configMapRef:
+                    name: shellter-config
+              env:
+                - name: POSTGRES_PASSWORD
+                  valueFrom:
+                    secretKeyRef:
+                      name: shellter-secrets
+                      key: POSTGRES_PASSWORD
+                - name: DATABASE_URL
+                  value: "postgresql://shellter:$(POSTGRES_PASSWORD)@postgres:5432/shellter"
+                - name: INSTANCE_ENCRYPTION_KEY
+                  valueFrom:
+                    secretKeyRef:
+                      name: shellter-secrets
+                      key: INSTANCE_ENCRYPTION_KEY
