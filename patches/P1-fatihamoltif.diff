--- /dev/null
+++ b/k8s/configmap.yaml
@@ -0,0 +1,20 @@
+# ConfigMap (partie P1, séance K2) — variables non secrètes de l'application.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: shellter-config
+  namespace: shellter
+data:
+  FLASK_CONFIG: "production"
+  # DATABASE_URL : le mot de passe est injecté séparément depuis le Secret (voir deployment).
+  DATABASE_HOST: "postgres"
+  DATABASE_NAME: "shellter"
+  DATABASE_USER: "shellter"
+  # Orchestrateur : sur la branche kubernetes, /rent passe par l'API K8s.
+  ORCHESTRATOR: "k8s"
+  # Namespace où créer les environnements loués.
+  SHELLTER_NAMESPACE: "shellter"
+  # Images SSH par distribution (poussées au registre, séance K3/P1).
+  SSH_IMAGE_UBUNTU: "ghcr.io/jamaiali/shellter-ssh-ubuntu:latest"
+  SSH_IMAGE_DEBIAN: "ghcr.io/jamaiali/shellter-ssh-debian:latest"
+  SSH_IMAGE_ALPINE: "ghcr.io/jamaiali/shellter-ssh-alpine:latest"
diff --git a/k8s/rbac.yaml b/k8s/rbac.yaml
new file mode 100644
index 0000000..3393a0b
--- /dev/null
+++ b/k8s/rbac.yaml
@@ -0,0 +1,35 @@
+# RBAC (partie P1, séance K3) — droits minimaux pour que Flask pilote le cluster.
+# Le Deployment Flask tourne sous ce ServiceAccount ; il peut créer/supprimer les
+# Deployments + Services des locations, mais rien d'autre (moindre privilège).
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: shellter-api
+  namespace: shellter
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: shellter-api
+  namespace: shellter
+rules:
+  - apiGroups: [""]
+    resources: ["pods", "pods/log", "services"]
+    verbs: ["get", "list", "watch", "create", "delete"]
+  - apiGroups: ["apps"]
+    resources: ["deployments"]
+    verbs: ["get", "list", "watch", "create", "delete"]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: RoleBinding
+metadata:
+  name: shellter-api
+  namespace: shellter
+subjects:
+  - kind: ServiceAccount
+    name: shellter-api
+    namespace: shellter
+roleRef:
+  kind: Role
+  name: shellter-api
+  apiGroup: rbac.authorization.k8s.io
diff --git a/k8s/secret.example.yaml b/k8s/secret.example.yaml
new file mode 100644
index 0000000..8b13671
--- /dev/null
+++ b/k8s/secret.example.yaml
@@ -0,0 +1,19 @@
+# Secret (partie P1, séance K2) — MODÈLE à copier en `secret.yaml` (NON versionné).
+# Les vraies valeurs proviennent du Vault Ansible. Création rapide en ligne :
+#
+#   kubectl -n shellter create secret generic shellter-secrets \
+#     --from-literal=SECRET_KEY='...' \
+#     --from-literal=POSTGRES_PASSWORD='...' \
+#     --from-literal=INSTANCE_ENCRYPTION_KEY='...'
+#
+apiVersion: v1
+kind: Secret
+metadata:
+  name: shellter-secrets
+  namespace: shellter
+type: Opaque
+stringData:
+  SECRET_KEY: "a-changer-en-prod"
+  POSTGRES_PASSWORD: "shellter"
+  # Clé Fernet (chiffrement des mots de passe SSH) — en générer une dédiée en prod.
+  INSTANCE_ENCRYPTION_KEY: "2NC-H59vV-_DzAajvYxi_NnNt66H3AMOX5YK64jFBCk="
